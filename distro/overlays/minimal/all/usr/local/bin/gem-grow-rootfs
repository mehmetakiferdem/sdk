#!/bin/bash

# Images are only as large as their content. On the first boot, grow the root
# partition, the last one on the disk, and its filesystem to fill the eMMC or
# SD card.

is_done=/etc/gem-grow-rootfs.isdone

if [ -f $is_done ]; then
    exit 0
fi

if [ "$EUID" -ne 0 ]; then
    echo "Please run as root"
    exit 1
fi

source=$(findmnt -n -o SOURCE /)
source=${source%%[*}    # btrfs reports /dev/xxx[/subvolume]
fstype=$(findmnt -n -o FSTYPE /)
sysfs=/sys/class/block/$(basename "$source")

if [ -f "$sysfs/partition" ]; then
    partnum=$(cat "$sysfs/partition")
    disk=/dev/$(basename "$(readlink -f "$sysfs/..")")

    # ", +" makes the partition as large as the free space after it
    echo ", +" | sfdisk --no-reread --no-tell-kernel -N "$partnum" "$disk" || exit 1
    partx -u -n "$partnum" "$disk"

    case "$fstype" in
        btrfs) btrfs filesystem resize max / ;;
        ext4)  resize2fs "$source" ;;
    esac
fi

systemctl disable gem-grow-rootfs.service
date > $is_done
