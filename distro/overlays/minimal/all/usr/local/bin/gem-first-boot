#!/bin/bash

is_done=/etc/gem-first-boot.isdone

if [ -f $is_done ]; then
    exit 0
fi

if [ "$EUID" -ne 0 ]; then
    echo "Please run as root"
    exit
fi

list=(
    "sys-kernel-debug.mount"
    "sys-kernel-tracing.mount"
    "apt-daily.service"
    "apt-daily.timer"
    "apt-daily-upgrade.service"
    "apt-daily-upgrade.timer"
    "dpkg-db-backup.timer"
)

for i in "${list[@]}"; do
    systemctl stop "$i"
    systemctl disable "$i"
done

configfile="/boot/config.ini"

if [ -f $configfile ]; then
    # shellcheck source=/dev/null
    source $configfile

    if [ -n "${firstboot+x}" ]; then
        if [ -n "$hostname" ]; then
            hostnamectl set-hostname "$hostname"
        fi

        if [ -n "$userpasswd" ]; then
            usermod -p "$userpasswd" gemstone
        fi

        if [ -n "$wifiname" ] && [ -n "$wifipasswd" ]; then
            wifi_conf_file="/etc/NetworkManager/system-connections/$wifiname.nmconnection"
            cat << EOF > "$wifi_conf_file"
[connection]
id=$wifiname
uuid=$(uuidgen)
type=wifi
autoconnect=true

[wifi]
ssid=$wifiname
mode=infrastructure
security=802-11-wireless-security

[wifi-security]
key-mgmt=wpa-psk
psk=$wifipasswd

[ipv4]
method=auto

[ipv6]
method=auto
EOF
            chmod 0600 "$wifi_conf_file"

            # NetworkManager hands iwd the psk as a passphrase, which can be at
            # most 63 characters, so iwd rejects a 64-digit PSK derived from it.
            # Give iwd the PSK itself, in its own profile for the network; iwd
            # names that file after the SSID, or its hex digits after "=" when
            # the SSID has characters other than letters, digits, " ", "-", "_".
            # Character ranges follow the locale; compare them in C.
            if LC_ALL=C grep -qxE '[0-9a-fA-F]{64}' <<< "$wifipasswd"; then
                if LC_ALL=C grep -qxE '[A-Za-z0-9 _-]+' <<< "$wifiname"; then
                    iwd_name=$wifiname
                else
                    iwd_name="=$(printf %s "$wifiname" | od -An -tx1 | tr -d ' \n')"
                fi
                mkdir -p -m 0700 /var/lib/iwd
                printf '[Security]\nPreSharedKey=%s\n' "$wifipasswd" > "/var/lib/iwd/$iwd_name.psk"
                chmod 0600 "/var/lib/iwd/$iwd_name.psk"
            fi
        fi

        if [ -n "$wificountry" ]; then
            echo "options cfg80211 ieee80211_regdom=\"$wificountry\"" > /etc/modprobe.d/wifi-regdom.conf
        fi

        systemctl restart NetworkManager

        if [ -n "$timezone" ]; then
            timedatectl set-timezone "$timezone"
        fi

        if [ -n "$keyboardlayout" ]; then
            kb_layout_file="/home/gemstone/.config/xfce4/xfconf/xfce-perchannel-xml/keyboard-layout.xml"
            sed -i 's/\(<property name="XkbLayout"[^>]*value="\)[^"]*"/\1'"$keyboardlayout"'"/' "$kb_layout_file"
            sed -i 's/\(<property name="XkbVariant"[^>]*value="\)[^"]*"/\1'""'"/' "$kb_layout_file"
            sed -i 's/XKBLAYOUT=.*/XKBLAYOUT='"${keyboardlayout}"'/' /etc/default/keyboard
        fi

        if [ -n "$vnc" ] && [ -n "$vncpassword" ]; then
            vnc_passwd_dir="/home/gemstone/.vnc/passwd"
            printf '%s' "$vncpassword" | xxd -r -p > "$vnc_passwd_dir"
            chown gemstone:gemstone "$vnc_passwd_dir"
            chmod 0600 "$vnc_passwd_dir"

            systemctl enable --now t3-gem-vnc.service
        fi
    fi

    sed -i '/firstboot=/d' $configfile
    sed -i '/userpasswd=/d' $configfile
    sed -i '/wifiname=/d' $configfile
    sed -i '/wifipasswd=/d' $configfile
    sed -i '/vncpassword=/d' $configfile
    sed -i '/diskpasswd=/d' $configfile
fi

systemctl disable gem-first-boot.service
date > $is_done
exit 0
